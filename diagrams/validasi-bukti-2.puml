@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial

|Admin|
start
:Buka /validasi-bukti/kelola;
|Sistem|
:Query semua bukti (filter status);
:Tampilkan tabel daftar bukti;
|Admin|
if (Pilih aksi?) then (Setujui)
  :Klik "Setujui";
  |Sistem|
  if (sopir_baru?) then (ya)
    :Auto-create sopir;
  endif
  if (tujuan_baru?) then (ya)
    :Auto-create tujuan;
  endif
  :Buat ritase: status=valid,\nhitungDt(), upah_sopir=0;
  :Update status = disetujui;
  :Redirect back;

elseif (Tolak) then
  :Input catatan penolakan;
  :Klik "Tolak";
  |Sistem|
  :Update status = ditolak;
  :Redirect back;

elseif (Tambah Ritase) then
  :Klik "Tambah ke Ritase";
  |Sistem|
  :Buat entri ritase baru\ndari data bukti;
  :Redirect ke /ritase;

elseif (Toggle Aturan) then
  :Klik toggle aturan;
  |Sistem|
  :Update status aturan di cache;
endif
stop
@enduml

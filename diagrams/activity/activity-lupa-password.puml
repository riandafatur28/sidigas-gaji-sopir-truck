@startuml activity-lupa-password
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Lupa Password

|User (Admin)|
start
:Buka halaman lupa password;
:Input email;

|Sistem|
:Cari user di DB;

|Database|
:SELECT * FROM users WHERE email = :email;

|Sistem|
if (User ditemukan?) then (Ya)
  :Generate OTP 6 digit;
  :Set expiry 5 menit;

  |Database|
  :INSERT INTO otps (email, otp, expires_at);

  |Sistem|
  :Kirim email OTP;

  |User (Admin)|
  :Buka email, salin OTP;
  :Input OTP;

  |Sistem|
  if (OTP valid?) then (Ya)
    :Redirect form reset password;

    |User (Admin)|
    :Input password baru × 2;
    :Klik "Reset";

    |Sistem|
    if (Password cocok?) then (Ya)
      |Database|
      :UPDATE password, DELETE otp;
      |Sistem|
      :Redirect /login;
    else (Tidak)
      :Error "Password tidak cocok";
    endif
  else (Tidak)
    :Error "OTP salah/expired";
  endif
else (Tidak)
  :Error "Email tidak ditemukan";
endif
stop

@enduml

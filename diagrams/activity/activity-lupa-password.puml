@startuml activity-lupa-password
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Lupa Password

|User|
start
:Buka halaman lupa password;
:Input email;

|System|
if (Email terdaftar?) then (Ya)
  :Generate OTP 6 digit;
  :Set expiry 5 menit;

  |DB|
  :INSERT INTO otps (email, otp, expires_at) VALUES (:email, :otp, NOW() + 5min);

  |System|
  :Kirim email berisi OTP;

  |User|
  :Buka email, salin OTP;
  :Input OTP di halaman verifikasi;

  |System|
  if (OTP valid & belum expired?) then (Ya)
    :Set session password_reset;
    :Redirect ke form reset password;

    |User|
    :Input password baru;
    :Konfirmasi password baru;
    :Klik "Reset Password";

    |System|
    if (Password cocok?) then (Ya)
      :Hash password baru;

      |DB|
      :UPDATE users SET password = :hashed_password WHERE email = :email;
      :DELETE FROM otps WHERE email = :email;

      |System|
      :Hapus session password_reset;
      :Tampilkan "Password berhasil direset";

      |User|
      :Redirect ke halaman login;
      stop
    else (Tidak)
      :Tampilkan "Password tidak cocok";
      |User|
      :Input ulang password;
      stop
    endif
  else (Tidak)
    :Tampilkan "OTP salah atau expired";
    |User|
    :Input ulang OTP / kirim ulang;
    stop
  endif
else (Tidak)
  :Tampilkan "Email tidak ditemukan";
  |User|
  :Tampilkan pesan error;
  stop
endif

@enduml

@startuml activity-lupa-password
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Lupa Password

|User (Admin)|
start
:Buka halaman lupa password;
:Input email;
:Klik "Kirim OTP";

|Sistem|
:Cari user di DB;

|Database|
:SELECT * FROM users WHERE email = :email;

|Sistem|
if (User ditemukan?) then (Ya)
  :Generate OTP 6 digit;
  :Set expiry 5 menit;

  |Database|
  :INSERT INTO otps (email, otp, expires_at);

  |Sistem|
  :Kirim email berisi OTP;

  |User (Admin)|
  :Buka email, salin OTP;
  :Input OTP di halaman verifikasi;
  :Klik "Verifikasi";

  |Sistem|
  if (OTP valid & belum expired?) then (Ya)
    :Redirect ke form reset password;

    |User (Admin)|
    :Input password baru;
    :Konfirmasi password baru;
    :Klik "Reset Password";

    |Sistem|
    if (Password cocok?) then (Ya)

      |Database|
      :UPDATE users SET password = :hashed WHERE email = :email;
      :DELETE FROM otps WHERE email = :email;

      |Sistem|
      :Redirect ke halaman login;
    else (Tidak)
      :Return error "Password tidak cocok";
    endif
  else (Tidak)
    :Return error "OTP salah atau expired";
  endif
else (Tidak)
  :Return error "Email tidak terdaftar";
endif
stop

@enduml

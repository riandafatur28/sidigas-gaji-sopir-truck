@startuml activity-validasi-bukti
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Validasi Bukti Kerja

|Sopir (Publik)|
start
:Buka link validasi bukti;
:Isi form (nama, tujuan, foto, catatan);
:Submit;

|Sistem|
:Ambil lokasi GPS;
:Validasi & upload foto;

|Database|
:INSERT validasi_bukti (status = 'pending');

|Sistem|
:Tampilkan "Bukti dikirim";
stop

' ===== ADMIN REVIEW =====

|User (Admin)|
:Buka halaman Kelola Validasi;

|Database|
:SELECT validasi_bukti WHERE status = 'pending';

|Sistem|
:Tampilkan daftar bukti;

|User (Admin)|
:Klik "Detail";
if (Bukti valid?) then (Ya)
  :Klik "Setujui";

  |Sistem|
  |Database|
  :UPDATE status = 'disetujui';
  if (Sopir baru?) then (Ya)
    :INSERT sopir baru;
  endif
  if (Tujuan baru?) then (Ya)
    :INSERT tujuan baru;
  endif

  |Sistem|
  if (Tambah ke Ritase?) then (Ya)
    |User (Admin)|
    :Pilih periode, waktu, kab;
    |Database|
    :INSERT ritase;
  endif
else (Tidak)
  :Klik "Tolak";
  :Isi catatan;
  |Database|
  :UPDATE status = 'ditolak';
endif
stop

@enduml

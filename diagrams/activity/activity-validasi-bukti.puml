@startuml activity-validasi-bukti
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Validasi Bukti Kerja

|Sopir (Publik)|
start
:Buka link validasi bukti;
:Isi form:
  - Nama sopir
  - Pilih/tulis tujuan
  - Upload foto bukti
  - Catatan (opsional);
:Submit bukti;

|System|
:Aktifkan GPS / ambil lokasi;
:Validasi input;
if (Valid?) then (Ya)
  :Compress & upload foto ke storage;
  :Simpan data bukti;

  |DB|
  :INSERT INTO validasi_bukti
   (nama_sopir, nama_tujuan, foto, latitude,
    longitude, lokasi, waktu_foto, status)
   VALUES (...);

  |System|
  :Tampilkan "Bukti berhasil dikirim";

  |Sopir (Publik)|
  :Selesai;
  stop
else (Tidak)
  :Tampilkan validasi error;
  |Sopir (Publik)|
  :Input ulang;
  stop
endif

' ===== ADMIN REVIEW =====

|Admin|
:Ambil data dari Database;

|DB|
:SELECT * FROM validasi_bukti WHERE status = 'pending';
:SELECT sopirs, tujuans (for reference);

|System|
:Tampilkan daftar bukti pending;

|Admin|
:Klik "Detail" pada bukti;
:Tampilkan foto, lokasi (peta), data sopir & tujuan;
if (Bukti valid?) then (Ya)
  :Klik "Setujui";
  |System|
  :Update status = 'disetujui';
  |DB|
  :UPDATE validasi_bukti SET status = 'disetujui';
  |System|
  if (Sopir baru?) then (Ya)
    :Buat sopir baru otomatis;
    |DB|
    :INSERT INTO sopirs (...);
  endif
  if (Tujuan baru?) then (Ya)
    :Buat tujuan baru otomatis;
    |DB|
    :INSERT INTO tujuans (...);
  endif
  :Tampilkan opsi "Tambah ke Ritase";
  |Admin|
  if (Tambah ke Ritase?) then (Ya)
    :Pilih periode, waktu, kabupaten;
    |DB|
    :INSERT INTO ritases (...);
  endif
else (Tidak)
  :Klik "Tolak";
  :Isi catatan penolakan;
  |System|
  :Update status = 'ditolak';
  |DB|
  :UPDATE validasi_bukti SET status = 'ditolak',
   catatan_mitra = :catatan;
endif

|Admin|
:Kembali ke daftar;
stop

@enduml

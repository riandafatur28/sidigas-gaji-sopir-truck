@startuml activity-login
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Login

|User (Admin)|
start
:Buka halaman login;
:Input email & password;
:Klik "Login";

|Sistem|
:Validasi input;
if (Valid?) then (Ya)
  :Cari user di DB;

  |Database|
  :SELECT * FROM users WHERE email = :email;

  |Sistem|
  if (User ditemukan?) then (Ya)
    if (Dari Google OAuth?) then (Ya)
      :Error "Gunakan login Google";
    else (Tidak)
      :Verifikasi password;
      if (Cocok?) then (Ya)
        if (Akun terkunci?) then (Ya)
          :Error "Akun terkunci";
        else (Tidak)
          |Database|
          :UPDATE login_attempts = 0, last_login = NOW();
          |Sistem|
          :Generate session;
          :Redirect /dashboard;
        endif
      else (Tidak)
        |Database|
        :UPDATE login_attempts += 1;
        |Sistem|
        :Error "Password salah";
      endif
    endif
  else (Tidak)
    :Error "Email tidak ditemukan";
  endif
else (Tidak)
  :Error validasi form;
endif
stop

@enduml

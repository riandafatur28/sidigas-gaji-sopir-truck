@startuml activity-penggajian
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Penggajian

|User (Admin)|
start
:Buka halaman Penggajian;
:Pilih periode;

|Sistem|
|Database|
:SELECT ritases WHERE periode_id = :periode;
:JOIN sopirs, tujuans;

|Sistem|

partition "Hitung Per Sopir" {
  while (Masih ada sopir?) is (Ya)
    :Group ritase per tujuan;
    :Hitung jumlah_rit, solar, upah, tol, DT;
    :Hitung kompensasi gagal produksi;
    :Hitung lembur;
    :Hitung grand total;
  endwhile (Tidak)
}

partition "Simpan" {
  |Database|
  :DELETE old penggajian WHERE periode = :periode;
  :INSERT penggajian + details;
}

|Sistem|
:Tampilkan tabel hasil;

|User (Admin)|
:Review hasil;
if (Perlu edit?) then (Ya)
  :Edit nominal;
  |Sistem|
  :Recalculate;
  |Database|
  :UPDATE penggajian;
endif

:Klik "Download Slip";

|Sistem|
:Generate PDF (4 slip/F4);
:Return file;
stop

@enduml

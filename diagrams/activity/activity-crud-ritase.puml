@startuml activity-crud-ritase
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — CRUD Ritase

|User (Admin)|
start
:Buka halaman Tabel Ritase;

partition "READ" {
  |Sistem|
  |Database|
  :SELECT ritases JOIN sopirs JOIN tujuans
   WHERE periode_id = :periode;
  |Sistem|
  :Tampilkan data dalam tabel;
  :User filter/search;
}

partition "CREATE (Manual)" {
  |User (Admin)|
  :Klik "Tambah";
  :Isi form (sopir, tujuan, tanggal, waktu, kab);
  :Klik "Simpan";

  |Sistem|
  :Validasi input;
  if (Valid?) then (Ya)
    :Hitung DT otomatis;
    |Database|
    :INSERT INTO ritases;
    |Sistem|
    :Refresh tabel;
  endif
}

partition "UPDATE" {
  |User (Admin)|
  :Klik edit;
  :Ubah data;
  :Klik "Update";

  |Sistem|
  :Recalculate DT;
  |Database|
  :UPDATE ritases;
}

partition "DELETE" {
  |User (Admin)|
  :Klik hapus + konfirmasi;

  |Sistem|
  if (Pakai di penggajian?) then (Ya)
    :Error "Tidak bisa hapus";
  else (Tidak)
    |Database|
    :DELETE FROM ritases;
  endif
}

partition "DETAIL (Pivot)" {
  |User (Admin)|
  :Klik "Lihat Detail";

  |Sistem|
  |Database|
  :SELECT sopir, tanggal, COUNT, SUM(dt, upah)
   GROUP BY sopir, tanggal;
  |Sistem|
  :Tampilkan pivot + ringkasan;
  :Download PDF (opsional);
}
stop

@enduml

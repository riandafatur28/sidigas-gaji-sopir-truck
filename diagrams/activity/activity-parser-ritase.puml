@startuml activity-parser-ritase
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Parser Ritase (WhatsApp)

|User (Admin)|
start
:Buka halaman Parser Ritase;
:Pilih periode;
:Copy-paste teks WhatsApp;
:Klik "Proses Teks";

|Sistem|
:Terima teks mentah;

partition "Step 1 — Extract Tanggal" {
  :Cari pola tanggal di teks;
  if (Ditemukan?) then (Ya)
    :Parse ke Date;
  else (Tidak)
    :Default = hari ini;
  endif
}

partition "Step 2 — Extract Sopir & Rute" {
  :Split per baris;
  while (Masih ada baris?) is (Ya)
    if (Baris = "N. Nama") then (Ya)
      :Extract nama sopir;
      :Baris berikutnya = rute;
    endif
  endwhile (Tidak)
}

partition "Step 3 — Fuzzy Matching" {
  while (Ada hasil parse?) is (Ya)
    :Hitung Jaro-Winkler vs sopir aktif;

    |Database|
    :SELECT sopirs WHERE status = 'aktif';

    |Sistem|
    if (Score >= 85%?) then (Ya)
      :Map ke sopir existing;
    else (Tidak)
      :Mark sopir baru;
    endif

    :Hitung Jaro-Winkler vs tujuan aktif;

    |Database|
    :SELECT tujuans WHERE status = 'aktif';

    |Sistem|
    if (Score >= 85%?) then (Ya)
      :Map ke tujuan existing;
    else (Tidak)
      :Mark tujuan baru;
    endif
  endwhile (Tidak)
}

partition "Step 4 — Preview" {
  |User (Admin)|
  :Tampilkan tabel preview;
  :Review data;
  :Klik "Simpan Semua";
}

partition "Step 5 — Simpan" {
  |Database|
  :INSERT sopir baru (jika ada);
  :INSERT tujuan baru (jika ada);
  :INSERT ritases;

  |Sistem|
  :Tampilkan "N ritase tersimpan";
}
stop

@enduml

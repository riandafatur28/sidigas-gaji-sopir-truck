@startuml activity-dashboard
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Dashboard

|User (Admin)|
start
:Buka /dashboard;

|Sistem|
:Cek cache metrics;

if (Cache valid?) then (Ya)
  :Load dari cache;
else (Tidak)
  |Database|
  :COUNT sopirs aktif;
  :COUNT periode aktif;
  :COUNT ritase periode aktif;
  :SUM total gaji;
  :COUNT bukti pending;

  |Sistem|
  :Hitung progress %;
  :Simpan ke cache (5 min);
endif

:Render dashboard;

|User (Admin)|
:Tampilkan:
  - Total sopir aktif
  - Periode aktif
  - Total ritase
  - Total gaji
  - Progress bar
  - Bukti pending;
stop

@enduml

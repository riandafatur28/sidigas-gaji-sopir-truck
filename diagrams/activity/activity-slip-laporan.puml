@startuml activity-slip-laporan
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Slip Gaji & Laporan PDF

|User (Admin)|
start

partition "SLIP GAJI" {
  :Pilih periode;
  :Klik "Download Slip";

  |Database|
  :SELECT penggajian + details + sopir
   WHERE periode = :periode;

  |Sistem|
  :Build data per sopir;
  :Format 4 slip/halaman F4;
  :Generate PDF (DomPDF);

  |User (Admin)|
  :Download slip PDF;
}

partition "LAPORAN" {
  :Klik "Download Laporan";

  |Database|
  :SELECT rekap per sopir
   WHERE periode = :periode;

  |Sistem|
  :Build tabel rekap;
  :Generate PDF (DomPDF);

  |User (Admin)|
  :Download laporan PDF;
}
stop

@enduml

@startuml activity-master-data
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Master Data (Sopir, Tujuan, Periode)

|User (Admin)|
start

partition "SOPIR" {
  :Buka halaman Sopir;
  if (Aksi?) then (Tambah)
    :Isi form (nama);
    |Sistem|
    :Generate kode SPR-NNN;
    :Validasi nama unik;
    |Database|
    :INSERT sopirs;
  elseif (Edit?) then (Ya)
    :Ubah data;
    |Database|
    :UPDATE sopirs;
  elseif (Hapus?) then (Ya)
    |Sistem|
    if (Punya ritase?) then (Ya)
      :Error "Tidak bisa hapus";
    else (Tidak)
      |Database|
      :DELETE sopirs;
    endif
  endif
}

partition "TUJUAN" {
  :Buka halaman Tujuan;
  if (Aksi?) then (Tambah)
    :Isi form (nama, koordinat);
    |Sistem|
    :Generate kode TUJ-NNN;
    |Database|
    :INSERT tujuans;
  elseif (Edit?) then (Ya)
    |Database|
    :UPDATE tujuans;
  elseif (Hapus?) then (Ya)
    |Sistem|
    if (Punya ritase?) then (Ya)
      :Error;
    else (Tidak)
      |Database|
      :DELETE tujuans;
    endif
  endif
}

partition "PERIODE" {
  :Buka halaman Periode;
  :Auto-sync status (aktif/selesai);
  if (Aksi?) then (Tambah)
    :Isi form (nama, tanggal);
    |Sistem|
    :Generate kode PRD-NNN;
    :Validasi overlap;
    |Database|
    :INSERT periodes;
  elseif (Edit?) then (Ya)
    |Database|
    :UPDATE periodes;
  elseif (Hapus?) then (Ya)
    |Sistem|
    if (Ada ritase/gaji?) then (Ya)
      :Error;
    else (Tidak)
      |Database|
      :DELETE periodes;
    endif
  endif
}
stop

@enduml

@startuml activity-autentikasi
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Activity Diagram — Autentikasi (Login, Google OAuth, Lupa Password)

|User (Admin)|
start
:Buka halaman login;

if (Pilih metode?) then (Email/Password)
  :Input email & password;
  :Klik "Login";

  |Sistem|
  :Validasi input;
  :Cari user di DB;

  |Database|
  :SELECT * FROM users WHERE email = :email;

  |Sistem|
  if (User ditemukan?) then (Ya)
    if (Google OAuth user?) then (Ya)
      :Error "Gunakan login Google";
    else (Tidak)
      :Verifikasi password;
      if (Cocok?) then (Ya)
        if (Akun terkunci?) then (Ya)
          :Error "Akun terkunci 30 menit";
        else (Tidak)
          |Database|
          :UPDATE login_attempts = 0, last_login = NOW();
          |Sistem|
          :Generate session;
          :Redirect /dashboard;
        endif
      else (Tidak)
        |Database|
        :UPDATE login_attempts += 1;
        |Sistem|
        :Error "Password salah";
      endif
    endif
  else (Tidak)
    :Error "Email tidak ditemukan";
  endif

elseif (Google OAuth)
  :Klik "Login dengan Google";

  |Sistem|
  :Redirect ke Google OAuth;

  |Google (Eksternal)|
  :Tampilkan consent screen;

  |User (Admin)|
  :Klik "Izinkan";

  |Sistem|
  :Terima callback + auth code;
  :Exchange code → access token;
  :Ambil data user dari Google;

  |Database|
  :SELECT user WHERE email = :email;
  if (Sudah ada?) then (Ya)
    :UPDATE google_id, last_login;
  else (Tidak)
    :INSERT user baru;
  endif

  |Sistem|
  :Generate session;
  :Redirect /dashboard;

elseif (Lupa Password)
  :Klik "Lupa Password";
  :Input email;

  |Sistem|
  :Cari user di DB;

  |Database|
  :SELECT user WHERE email = :email;

  |Sistem|
  if (User ditemukan?) then (Ya)
    :Generate OTP 6 digit;
    :Set expiry 5 menit;

    |Database|
    :INSERT INTO otps;

    |Sistem|
    :Kirim email OTP;

    |User (Admin)|
    :Buka email, salin OTP;
    :Input OTP;

    |Sistem|
    if (OTP valid?) then (Ya)
      :Redirect form reset password;

      |User (Admin)|
      :Input password baru × 2;
      :Klik "Reset";

      |Sistem|
      if (Password cocok?) then (Ya)
        |Database|
        :UPDATE password, DELETE otp;
        |Sistem|
        :Redirect /login;
      else (Tidak)
        :Error "Password tidak cocok";
      endif
    else (Tidak)
      :Error "OTP salah/expired";
    endif
  else (Tidak)
    :Error "Email tidak ditemukan";
  endif
endif

stop

@enduml

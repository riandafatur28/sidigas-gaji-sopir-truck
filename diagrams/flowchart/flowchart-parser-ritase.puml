@startuml flowchart-parser-ritase
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Flowchart — Parser Ritase

start
:Teks WhatsApp mentah;
:Trim, normalize;

partition "1. Tanggal" {
  :Regex: \b(\d{1,2})\s?[-/.]?\s?(\d{1,2})\s?[-/.]?\s?(\d{2,4})\b;
  if (Match?) then (Ya)
    :Parse DD MM YY/YYYY;
  else (Tidak)
    :Default = hari ini;
  endif
}

partition "2. Sopir & Rute" {
  :Split per baris;
  while (Baris berawalan "N. Nama"?) is (Ya)
    :Extract nama sopir;
    :Baris berikutnya = rute;
  endwhile (Tidak)
}

partition "3. Fuzzy Match" {
  :Sopir: Jaro-Winkler vs DB;
  if (>= 85%?) then (Ya)
    :Existing;
  else (Tidak)
    :Sopir baru;
  endif
  :Tujuan: Jaro-Winkler vs DB;
  if (>= 85%?) then (Ya)
    :Existing;
  else (Tidak)
    :Tujuan baru;
  endif
}

partition "4. Hitung DT" {
  if (Kab in [Nganjuk, Kediri, Kota Kediri, Jombang]?) then (Ya)
    if (Sudah 1 DT hari ini?) then (Ya)
      :DT = 0;
    else (Tidak)
      :DT = 330000;
    endif
  else (Tidak)
    :DT = 330000;
  endif
  if (Gagal produksi?) then (Ya)
    :DT = 0;
    :Kompensasi = nominal;
  endif
}

:Return parsed_items[];
stop

@enduml

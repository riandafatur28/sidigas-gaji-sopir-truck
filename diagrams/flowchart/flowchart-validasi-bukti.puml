@startuml flowchart-validasi-bukti
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Flowchart — Validasi Bukti

start
:Input (nama, tujuan, foto, lokasi);
:Validasi form;

if (Nama kosong?) then (Ya)
  :Error "Nama wajib";
  stop
endif
if (Foto kosong?) then (Ya)
  :Error "Foto wajib";
  stop
endif
if (Lokasi kosong?) then (Ya)
  :Error "Lokasi GPS wajib";
  stop
endif

:Compress & upload foto;
:Simpan ke DB (status = 'pending');

' ===== REVIEW =====
:Admin lihat bukti;
if (Valid?) then (Ya)
  :Status → disetujui;
  if (Sopir baru?) then (Ya)
    :Auto-create sopir;
  endif
  if (Tujuan baru?) then (Ya)
    :Auto-create tujuan;
  endif
  :Opsi tambah ke ritase;
else (Tidak)
  :Status → ditolak;
  :Catatan penolakan;
endif
stop

@enduml

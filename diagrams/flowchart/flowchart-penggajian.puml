@startuml flowchart-penggajian
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Flowchart — Penggajian

start
:Input periode_id;
:Ambil semua ritase;
:Group per sopir;

while (Masih ada sopir?) is (Ya)
  :Init total = 0;

  while (Masih ada tujuan?) is (Ya)
    :jumlah_rit = COUNT;
    :solar = jumlah_rit × config.solar;
    :upah = jumlah_rit × config.upah;
    :tol = jumlah_rit × config.tol;

    if (Gagal produksi?) then (Ya)
      :dt = 0;
      :kompensasi = nominal;
    else (Tidak)
      if (Kab [Nganjuk, Kediri, Kota Kediri, Jombang]?) then (Ya)
        if (Sudah 1 DT?) then (Ya)
          :dt = 0;
        else (Tidak)
          :dt = config.dt;
        endif
      else (Tidak)
        :dt = config.dt;
      endif
      :kompensasi = 0;
    endif
  endwhile (Tidak)

  if (Ada lembur?) then (Ya)
    :lembur = COUNT × nominal;
  else (Tidak)
    :lembur = 0;
  endif

  :grand_total = solar + upah + dt + tol + kompensasi + lembur;
  :INSERT penggajian + details;
endwhile (Tidak)

:Tampilkan hasil;
stop

@enduml

@startuml flowchart-login
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Flowchart — Login

start
:Input email & password;
:Validasi form;
if (Email kosong?) then (Ya)
  :Error "Email wajib";
  stop
endif
if (Password kosong?) then (Ya)
  :Error "Password wajib";
  stop
endif

:Cari user by email;
if (Ditemukan?) then (Ya)
  if (Google OAuth user?) then (Ya)
    :Error "Gunakan login Google";
    stop
  endif
  if (Password cocok?) then (Ya)
    if (Akun terkunci?) then (Ya)
      :Error "Akun terkunci";
      stop
    endif
    :Reset attempts;
    :Update last_login;
    :Generate session;
    :Redirect /dashboard;
    stop
  else (Tidak)
    :attempts += 1;
    if (>= 5?) then (Ya)
      :Lock akun 30 menit;
    endif
    :Error "Password salah";
    stop
  endif
else (Tidak)
  :Error "Email tidak ditemukan";
  stop
endif

@enduml

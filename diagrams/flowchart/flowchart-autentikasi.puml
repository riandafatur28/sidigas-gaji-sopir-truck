@startuml flowchart-autentikasi
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Flowchart — Autentikasi

start

if (Metode?) then (Email/Password)
  :Input email & password;
  if (Email kosong?) then (Ya)
    :Error "Wajib";
    stop
  endif
  if (Password kosong?) then (Ya)
    :Error "Wajib";
    stop
  endif
  :Cari user;
  if (Ditemukan?) then (Ya)
    if (Google user?) then (Ya)
      :Error "Gunakan Google";
      stop
    endif
    if (Password cocok?) then (Ya)
      if (Ter-kunci?) then (Ya)
        :Error "Terkunci";
      stop
      endif
      :Session;
      :Redirect /dashboard;
      stop
    else (Tidak)
      :attempts += 1;
      if (>= 5?) then (Ya)
        :Lock 30m;
      endif
      :Error "Salah";
      stop
    endif
  else (Tidak)
    :Error "Tidak ditemukan";
    stop
  endif

elseif (Google OAuth)
  :Redirect Google;
  :User izinkan;
  :Get token + user info;
  :Cari/insert user;
  :Session;
  :Redirect /dashboard;
  stop

elseif (Lupa Password)
  :Input email;
  if (Ditemukan?) then (Ya)
    :Generate OTP → kirim email;
    :User input OTP;
    if (OTP valid?) then (Ya)
      :Form password baru;
      if (Cocok?) then (Ya)
        :Update password;
        :Redirect /login;
        stop
      else (Tidak)
        :Error;
        stop
      endif
    else (Tidak)
      :Error "OTP salah";
      stop
    endif
  else (Tidak)
    :Error "Tidak ditemukan";
    stop
  endif
endif

@enduml

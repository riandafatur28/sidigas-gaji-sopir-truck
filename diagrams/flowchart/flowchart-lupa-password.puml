@startuml flowchart-lupa-password
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial

title Flowchart — Lupa Password

|User|
start
:Input email;
:Klik "Kirim OTP";

|Sistem|
:Cari user di DB;
if (User ditemukan?) then (Ya)
  :Generate OTP 6 digit;
  :Set expiry 5 menit;
  :Simpan ke DB;
  :Kirim email OTP;

  |User|
  :Buka email, salin OTP;
  :Input OTP;
  :Klik "Verifikasi";

  |Sistem|
  if (OTP valid & belum expired?) then (Ya)
    :Redirect form reset password;

    |User|
    :Input password baru × 2;
    :Klik "Reset";

    |Sistem|
    if (Password cocok?) then (Ya)
      :Hash password baru;
      :Update di DB;
      :Hapus OTP dari DB;
      :Redirect /login;
      stop
    else (Tidak)
      :Error "Tidak cocok";
      stop
    endif
  else (Tidak)
    :Error "OTP salah/expired";
    stop
  endif
else (Tidak)
  :Error "Email tidak ditemukan";
  stop
endif

@enduml

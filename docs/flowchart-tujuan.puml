@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title **Flowchart Kelola Tujuan**

partition "Lihat Daftar Tujuan" {
  start
  :Buka /tujuan;
  :Query semua tujuan\n(paginated);
  :Tampilkan tabel\n(kode, nama, status);
  stop
}

partition "Tambah Tujuan" {
  start
  :Klik tombol "Tambah";
  :Buka modal form;
  :Input kode_tujuan & nama;
  :Submit form;
  if (Validasi lolos?) then (ya)
    :Simpan ke tabel tujuans;\n(auto-generate kode_tujuan\njika kosong);
    :Redirect back\n(tetap di halaman yang sama);
    :Tutup modal;
    :Tampilkan sukses;
  else (tidak)
    :Tampilkan error;
  endif
  stop
}

partition "Edit Tujuan" {
  start
  :Klik tombol "Edit";
  :Buka modal form\ndengan data lama;
  :Ubah kode_tujuan / nama / status;
  :Submit form;
  if (Validasi lolos?) then (ya)
    :Update tabel tujuans;
    :Redirect back;
    :Tutup modal;
  else (tidak)
    :Tampilkan error;
  endif
  stop
}

partition "Hapus Tujuan" {
  start
  :Klik tombol "Hapus";
  :Konfirmasi delete;
  if (Dikonfirmasi?) then (ya)
    :Hapus dari tabel tujuans\n(cascade ke ritase,\npenggajian_details,\nvalidasi terkait);
    :Redirect back;
  endif
  stop
}

@enduml

@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam activityBorderColor #2b6cb0
skinparam activityBackgroundColor #ebf8ff
skinparam arrowColor #2d3748

title **Activity Diagram - Lupa Password**

start
:Admin klik "Lupa Password";
:Buka form input email;
:Input email & submit;
:Sistem generate OTP 6 digit;
:Kirim OTP ke email;

if (OTP dikirim?) then (ya)
  :Admin buka email;
  :Input kode OTP;
  :Submit form OTP;

  if (OTP cocok &\nbelum expired?) then (ya)
    :Tampilkan form\npassword baru;
    :Input password baru\n& konfirmasi;
    :Hash password;
    :Update tabel users;
    :Redirect ke /login;
    stop
  else (tidak)
    :Tampilkan error\n"OTP salah / kadaluarsa";
    :Kembali ke form OTP;
    stop
  endif

else (tidak)
  :Tampilkan error\n"Email tidak ditemukan";
  stop
endif

@enduml

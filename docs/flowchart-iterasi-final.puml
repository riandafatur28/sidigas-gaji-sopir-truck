@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title Final - Lengkap (Semua Permintaan Terpenuhi)

partition "Ritase - Paste WA + Lengkap" {
  start
  :Paste teks WA;
  :Parse otomatis;
  :Mapping kecamatan ke kabupaten;
  :Cek DT;
  :Detail pivot + PDF dark mode;
  stop
}

partition "Validasi Bukti - Pilih Dropdown" {
  start
  :Sopir buka form validasi;
  :Pilih nama dari dropdown;
  :Pilih tujuan dari dropdown;
  :(kecuali sopir/tujuan baru,\nbaru ngetik manual);
  :Ambil foto;
  :Kirim;
  stop
  note right
    **Mitra minta:**
    "Biar tinggal pilih aja,
    biar ga salah ketik"
  end note
}

partition "Penggajian - Polish" {
  start
  :Slip 4 per halaman F4;
  :Dark mode;
  :Laporan grid rapi (1.5px);
  stop
}

@enduml

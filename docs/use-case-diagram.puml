@startuml
skinparam packageStyle rectangle
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10
skinparam defaultFontName Arial
skinparam usecaseFontSize 10
skinparam packageBorderColor #4a5568
skinparam packageBackgroundColor #f7fafc
skinparam packageFontSize 11
skinparam packageFontStyle bold

top to bottom direction

actor "Admin/Operator" as Admin
actor "Sopir\n(Tanpa Login)" as Sopir

rectangle "Autentikasi" {
  (Login) as A1
  (Logout) as A2
  (Lupa Password) as A3
  (Reset Password) as A4
  (Profil) as A5
}
rectangle "Dashboard" {
  (Ringkasan) as D1
}
rectangle "Sopir" {
  (CRUD Sopir) as S1
}
rectangle "Tujuan" {
  (CRUD Tujuan) as T1
}
rectangle "Periode" {
  (CRUD Periode) as P1
}
rectangle "Ritase" {
  (Parse Teks) as R1
  (CRUD Manual) as R2
  (Detail Pivot) as R3
  (Download PDF) as R4
  (Cek DT) as R5
}
rectangle "Penggajian" {
  (Hitung Gaji) as G1
  (Riwayat) as G2
  (Slip Modal) as G3
  (Download Slip) as G4
  (Download Laporan) as G5
}
rectangle "Validasi Bukti" {
  (Submit Bukti) as V1
  (Kelola) as V2
  (Setujui/Tolak) as V3
  (Tambah Ritase) as V4
  (Toggle Aturan) as V5
}

Sopir --> V1

Admin --> A1
Admin --> A2
Admin --> A3
Admin --> A4
Admin --> A5
Admin --> D1
Admin --> S1
Admin --> T1
Admin --> P1
Admin --> R1
Admin --> R2
Admin --> R3
Admin --> R4
Admin --> R5
Admin --> G1
Admin --> G2
Admin --> G3
Admin --> G4
Admin --> G5
Admin --> V2
Admin --> V3
Admin --> V4
Admin --> V5

G2 ..> G1 : <<include>>
G3 ..> G1 : <<include>>
R3 ..> R2 : <<include>>
V3 ..> V2 : <<include>>
V4 ..> V2 : <<include>>

@enduml

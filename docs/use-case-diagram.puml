@startuml
skinparam packageStyle rectangle
skinparam usecaseBorderColor #2b6cb0
skinparam usecaseBackgroundColor #ebf4ff
skinparam actorBorderColor #2d3748
skinparam actorBackgroundColor #e2e8f0
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam package {
  BorderColor #4a5568
  BackgroundColor #f7fafc
  FontColor #1a202c
  FontSize 12
  FontStyle bold
}

left to right direction

' ========== ACTORS ==========
actor Admin as "Admin/Operator"
actor Guest as "Pengunjung\n(Guest)"

' ========== PACKAGES ==========

package "Autentikasi" {
  (UC01) as "Login\n(Email/Password)"
  (UC02) as "Login Google"
  (UC03) as "Lupa Password\n(OTP Email)"
  (UC04) as "Reset Password"
  (UC05) as "Logout"
  (UC06) as "Lihat/Edit Profil"
}

package "Kelola Sopir" {
  (UC10) as "Lihat Daftar Sopir"
  (UC11) as "Tambah Sopir"
  (UC12) as "Edit Sopir"
  (UC13) as "Hapus Sopir"
}

package "Kelola Tujuan" {
  (UC20) as "Lihat Daftar Tujuan"
  (UC21) as "Tambah Tujuan"
  (UC22) as "Edit Tujuan"
  (UC23) as "Hapus Tujuan"
}

package "Kelola Periode" {
  (UC30) as "Lihat Periode"

@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial

|Admin|
start
:Buka /sopir;

|Sistem|
:Query semua sopir\n(paginated 10/halaman);
:Tampilkan tabel sopir;

repeat
  |Admin|
  if (Pilih aksi?) then (Tambah)
    :Klik "Tambah";
    :Isi form data sopir;
    :Submit;
    |Sistem|
    if (Validasi lolos?) then (ya)
      :Simpan ke tabel sopirs;
      :Redirect back\n(tetap di halaman);
      |Admin|
      :Lihat tabel terbaru;
    else (tidak)
      :Tampilkan error;
      |Admin|
      :Lihat pesan error;
    endif

  elseif (Edit) then
    :Klik tombol "Edit"\npada baris;
    |Sistem|
    :Load data sopir;
    :Tampilkan modal form\ndengan data lama;
    |Admin|
    :Ubah data;
    :Submit;
    |Sistem|
    if (Validasi lolos?) then (ya)
      :Update tabel sopirs;
      :Redirect back;
      |Admin|
      :Lihat data terbaru;
    else (tidak)
      :Tampilkan error;
    endif

  elseif (Hapus) then
    :Klik "Hapus";
    if (Konfirmasi?) then (ya)
      |Sistem|
      :Hapus dari sopirs\n(CASCADE ke tabel terkait);
      :Redirect back;
    endif

  else (Navigasi)
    :Klik nomor halaman;
    |Sistem|
    :Query halaman berikutnya;
    :Render tabel;
  endif

repeat while (Masih di halaman sopir?) is (ya)
->tidak;
stop

@enduml

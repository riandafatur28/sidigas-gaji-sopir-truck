@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam activityBorderColor #2b6cb0
skinparam activityBackgroundColor #ebf8ff
skinparam arrowColor #2d3748

title **Activity Diagram - Autentikasi**

start
:Admin buka /login;
:Input email & password;
:Kirim POST ke /login;

if (Email & password valid?) then (ya)
  :Simpan session;
  :Redirect ke /dashboard;
  stop
else (tidak)
  :Tampilkan error\n"Email atau password salah";
  :Kembali ke form login;
  stop
endif


@enduml

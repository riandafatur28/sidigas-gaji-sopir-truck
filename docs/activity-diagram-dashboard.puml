@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam activityBorderColor #2b6cb0
skinparam activityBackgroundColor #ebf8ff
skinparam arrowColor #2d3748

title **Activity Diagram - Dashboard**

start
:Admin login & buka /dashboard;
:Sistem query data periode aktif;

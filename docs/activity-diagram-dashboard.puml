:Sistem hitung total gaji\n(periode aktif);
:Sistem hitung jumlah\nsopir & tujuan aktif;
:Sistem hitung statistik\nper sopir (total rit, gaji, DT);
:Tampilkan card statistik\ndan chart ringkasan;
stop

@enduml

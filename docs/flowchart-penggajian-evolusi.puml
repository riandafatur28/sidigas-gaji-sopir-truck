@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title Evolusi Fitur Penggajian dari Kebutuhan Mitra

partition "Iterasi 1 - Sudah Jalan" {
  start
  :Input biaya solar & upah;
  :Klik Hitung Gaji;
  :Total gaji tampil;
  :Download slip & laporan PDF;
  stop
  note right
    **Masalah dari Mitra:**
    - Riwayat gaji numpuk, susah cari
    - Slip kebuka di tab baru
    - Tampilan masih mentah
  end note
}

partition "Iterasi 2 - Ditingkatkan" {
  start
  :Filter riwayat gaji\n(pilih bulan, tahun, urut);
  :Lihat hasil gaji periode tertentu;
  :Lihat slip di modal\n(ga buka tab baru);
  stop
  note right
    **Perbaikan dari keluhan Mitra:**
    - Riwayat gampang dicari pake filter
    - Slip liat di modal, ga ganggu
  end note
}

partition "Final - Polish" {
  start
  :Slip gaji 4 per halaman F4\n(ukuran pas, gak terlalu kecil);
  :Dark mode buat pemakaian malam;
  :Download laporan dengan tabel rapi;
  stop
  note right
    **Tambahan dari Mitra:**
    - Slip diperbesar biar jelas
    - Enak dipake di tempat gelap
  end note
}

@enduml

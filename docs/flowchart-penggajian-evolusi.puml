@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title Evolusi Fitur Penggajian dari Kebutuhan Mitra

partition "Iterasi 1 - Sederhana" {
  start
  :Input biaya solar & upah;
  :Klik Hitung Gaji;
  :Total gaji tampil;
  :Download slip PDF;
  :Download laporan PDF;
  stop
  note right
    **Keluhan Mitra:**
    - Riwayat gaji numpuk ke bawah
    - Susah cari periode lama
    - Slip buka tab baru
  end note
}

partition "Iterasi 2 - Filter & Modal" {
  start
  :Filter riwayat per bulan & tahun;
  :Urutkan terbaru / terlama;
  :Lihat slip di modal\n(ga buka tab baru);
  :Download slip & laporan PDF;
  stop
  note right
    **Yang didapat Mitra:**
    - Riwayat gampang dicari
    - Slip liat di modal, praktis
  end note
}

partition "Final - Polish" {
  start
  :Slip 4 per halaman F4\n(ukuran pas, gak terlalu kecil);
  :Dark mode buat pemakaian malam;
  :Download laporan dengan tabel rapi;\n(border 1.5px);
  stop
}

@enduml

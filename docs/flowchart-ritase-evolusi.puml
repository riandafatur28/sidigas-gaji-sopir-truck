@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title Evolusi Fitur Ritase dari Kebutuhan Mitra

partition "Iterasi 1 - Input Manual" {
  start
  :Klik Tambah Ritase;
  :Pilih sopir dari dropdown;
  :Pilih tujuan dari dropdown;
  :Input tanggal, waktu, DT;
  :Simpan;
  :Ulang untuk setiap ritase\n(satu per satu);
  stop
  note right
    **Keluhan Mitra:**
    - Capek input satu-satu
    - Butuh waktu lama kalau ritase banyak
    - Minta: "Bisa dari teks WA aja?"
  end note
}

partition "Iterasi 2 - Otomatis dari WA" {
  start
  :Paste teks grup WA\n(berisi semua ritase hari itu);
  :Klik Parse;
  :Sistem cocokkan nama sopir & tujuan\notomatis;
  :Sopir & tujuan baru auto-terdaftar;
  :Ritase gagal produksi otomatis;
  :Preview hasil;
  :Simpan semua sekaligus;
  stop
  note right
    **Yang didapat Mitra:**
    - Tinggal copy paste dari WA
    - Semua ritase langsung jadi
    - Ga perlu input satu-satu
  end note
}

partition "Final - Lengkap" {
  start
  :Paste teks grup WA;
  :Klik Parse;
  :Otomatis mapping kecamatan ke kabupaten;
  :Cek DT per sopir per tujuan;
  :Detail pivot + PDF dengan dark mode;
  stop
}

@enduml

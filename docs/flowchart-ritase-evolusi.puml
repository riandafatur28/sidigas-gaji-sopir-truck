@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title Evolusi Fitur Ritase dari Kebutuhan Mitra

partition "Iterasi 1 - Sudah Jalan" {
  start
  :Paste teks ritase;
  :Klik Parse;
  :Hasil parsing muncul\n(beberapa menit, kadang berubah-ubah);
  :Simpan ritase;
  stop
  note right
    **Masalah dari Mitra:**
    - Loading lama (tunggu beberapa menit)
    - Hasil kadang beda walau teks sama
    - Nama sopir kadang salah cocok
  end note
}

partition "Iterasi 2 - Ditingkatkan" {
  start
  :Paste teks ritase;
  :Klik Parse;
  :Hasil parsing muncul\n(dalam hitungan detik, konsisten);
  :Sopir & tujuan baru otomatis terdaftar;
  :Ritase gagal produksi otomatis terdeteksi;
  stop
  note right
    **Perbaikan dari keluhan Mitra:**
    - Loading cepat (detik, bukan menit)
    - Hasil tetap sama tiap parse
    - Nama sopir cocok otomatis
    - Sopir/tujuan baru gausah diinput manual
  end note
}

partition "Final - Lengkap" {
  start
  :Paste teks ritase;
  :Klik Parse;
  :Hasil parsing cepat & akurat;
  :Otomatis mapping kecamatan ke kabupaten;
  :Filter & cek DT;
  :Lihat detail pivot + PDF;\n(bisa dark mode);
  stop
  note right
    **Tambahan dari Mitra:**
    - Kota asal otomatis terisi
    - Bisa cek DT langsung
    - Tampilan detail lebih rapi
  end note
}

@enduml

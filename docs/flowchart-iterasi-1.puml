@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 12
skinparam defaultFontName Arial
skinparam rectangleBorderColor #2b6cb0
skinparam rectangleBackgroundColor #ebf8ff
skinparam rectangleBorderThickness 2
skinparam arrowColor #2d3748
skinparam ArrowThickness 1.5

title **Alur Sistem - Iterasi 1**

rectangle "Login" as LOGIN
rectangle "CRUD\nSopir / Tujuan / Periode" as CRUD
rectangle "Input Ritase\nManual" as RIT_MANUAL
rectangle "Parser Ritase\n(LLM + Rule)" as RIT_LLM
rectangle "Preview\nHasil Parsing" as PREVIEW
rectangle "Hitung Gaji\n(Input Biaya)" as GAJI
rectangle "Slip & Laporan\nPDF" as PDF
rectangle "Validasi Bukti\n(Manual)" as VALIDASI

LOGIN --> CRUD
LOGIN --> RIT_MANUAL
LOGIN --> RIT_LLM
RIT_LLM --> PREVIEW
PREVIEW --> RIT_MANUAL
RIT_MANUAL --> GAJI
GAJI --> PDF
LOGIN --> VALIDASI

@enduml

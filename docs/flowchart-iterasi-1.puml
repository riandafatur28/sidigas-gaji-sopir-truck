@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title Iterasi 1 - Input Manual (Semua)

partition "Ritase - Manual" {
  start
  :Buka halaman ritase;
  :Klik Tambah;
  :Pilih sopir dari dropdown;
  :Pilih tujuan dari dropdown;
  :Input tanggal & waktu;
  :Input nominal DT;
  :Simpan;
  :Ulang untuk setiap ritase\n(satu per satu, hari itu bisa\n10-20 ritase);
  stop
}

partition "Validasi Bukti - Manual" {
  start
  :Sopir buka form validasi;
  :Ketik manual nama sopir;
  :Ketik manual nama tujuan;
  :Ambil foto;
  :Kirim;
  stop
}

partition "Penggajian - Sederhana" {
  start
  :Input biaya solar & upah;
  :Hitung gaji;
  :Download PDF;
  stop
}

@enduml

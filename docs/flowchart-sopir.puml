@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title **Flowchart Kelola Sopir**

partition "Lihat Daftar Sopir" {
  start
  :Buka /sopir;
  :Query semua sopir\n(paginated);
  :Tampilkan tabel\n(kode, nama, status);
  stop
}

partition "Tambah Sopir" {
  start
  :Klik tombol "Tambah";
  :Buka modal form;
  :Input kode_sopir & nama;
  :Submit form;
  if (Validasi lolos?) then (ya)
    :Simpan ke tabel sopirs;\n(auto-generate kode_sopir\njika kosong);
    :Redirect back\n(tetap di halaman yang sama);
    :Tutup modal;
    :Tampilkan sukses;
  else (tidak)
    :Tampilkan error\n(misal: kode sudah ada);
  endif
  stop
}

partition "Edit Sopir" {
  start
  :Klik tombol "Edit";
  :Buka modal form\ndengan data lama;
  :Ubah kode_sopir / nama / status;
  :Submit form;
  if (Validasi lolos?) then (ya)
    :Update tabel sopirs;
    :Redirect back;
    :Tutup modal;
  else (tidak)
    :Tampilkan error;
  endif
  stop
}

partition "Hapus Sopir" {
  start
  :Klik tombol "Hapus";
  :Konfirmasi delete\n(alert javascript);
  if (Dikonfirmasi?) then (ya)
    :Hapus dari tabel sopirs\n(cascade ke ritase,\npenggajian, validasi terkait);
    :Redirect back;
  endif
  stop
}

@enduml

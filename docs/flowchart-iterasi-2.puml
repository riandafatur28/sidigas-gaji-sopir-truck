@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title Iterasi 2 - Otomatis dari WA (Permintaan Mitra)

partition "Ritase - Paste Teks WA" {
  start
  :Copy teks grup WA\n(berisi semua ritase hari itu);
  :Buka halaman parse;
  :Paste teks;
  :Klik Parse;
  :Sistem cocokkan sopir & tujuan\notomatis;
  :Preview hasil;
  :Simpan semua sekaligus;
  stop
  note right
    **Mitra minta:**
    "Bisa dari teks WA aja?
    capek input satu-satu"
  end note
}

partition "Validasi Bukti - Masih Manual" {
  start
  :Sopir ketik manual\nnama & tujuan;
  :(belum ada dropdown);
  stop
}

partition "Penggajian - Ditambah Filter" {
  start
  :Filter riwayat per bulan/tahun;
  :Lihat slip di modal;
  stop
}

@enduml

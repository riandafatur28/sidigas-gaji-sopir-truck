@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial

|Admin|
start
:Buka /gaji;

|Sistem|
:Load periode aktif;
:Query sopir + ritase\nperiode aktif;
:Tampilkan tabel\ninput biaya;

|Admin|
if (Aksi?) then (Hitung Gaji)
  :Input biaya tiap tujuan:
  - uang_solar
  - upah_sopir
  - sewa_dt
  - tol_per_rit;
  :Klik "Hitung";
  |Sistem|
  :Kalkulasi per detail:
  - total_solar = jml_rit x solar
  - total_upah = jml_rit x upah
  - total_tol = jml_rit x tol
  - subtotal = solar + upah + sewa_dt + tol;
  :Kalkulasi header:
  - uang_solar = sum solar
  - upah_sopir = sum upah
  - dt = sum sewa_dt
  - tol = sum tol
  - kompensasi = dari rit gagal
  - upah_lembur = dari rit lembur
  - total = semua komponen;
  :Simpan ke penggajian\n+ penggajian_details;
  :Tampilkan hasil\n(grand total);

elseif (Riwayat) then
  :Buka /gaji/riwayat;
  if (Filter?) then (ya)
    :Pilih bulan, tahun,\nurutan;
    |Sistem|
    :Query filter;
  endif
  |Sistem|
  :Tampilkan riwayat periode;
  |Admin|
  :Klik periode → lihat detail;

elseif (Lihat Slip) then
  :Klik "Lihat Slip";
  |Sistem|
  :Fetch data slip via AJAX;
  :Sisipkan HTML ke modal\n(strip global CSS);
  :Tampilkan slip;

elseif (Download Slip) then
  :Klik "Download Slip";
  |Sistem|
  :Generate PDF via DomPDF\n(4 slip per F4);
  :Download slip.pdf;

elseif (Download Laporan) then
  :Klik "Download Laporan";
  |Sistem|
  :Generate PDF laporan\n(semua sopir + tujuan);
  :Download laporan.pdf;
endif
stop

@enduml

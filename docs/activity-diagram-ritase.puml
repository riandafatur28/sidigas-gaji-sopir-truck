@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam activityBorderColor #2b6cb0
skinparam activityBackgroundColor #ebf8ff
skinparam arrowColor #2d3748

title **Activity Diagram - Kelola Ritase**

start
:Admin buka /ritase;
:Sistem filter periode aktif;
:Query ritase periode aktif;
:Tampilkan tabel ritase;

if (Pilih aksi?) then (Parse Teks)
  :Buka /ritase/parse;
  :Paste teks ritase;
  :Klik "Parse";
  :Sistem parsing teks\n(jumlah rit, tujuan, dt);
  if (Berhasil?) then (ya)
    :Tampilkan preview hasil;
    if (Simpan?) then (ya)
      :Simpan semua ritase ke DB;
      :Redirect ke /ritase;
    endif
  else (tidak)
    :Tampilkan error format;
  endif

elseif (Tambah Manual) then
  :Klik "Tambah";
  :Modal form\n(sopir, tujuan, tanggal,\nwaktu, kabupaten, dt);
  :Submit → simpan ke DB;
  :Redirect back;

elseif (Edit) then
  :Klik "Edit";
  :Ubah data via modal;
  :Submit → update DB;
  :Redirect back;

elseif (Hapus) then
  :Konfirmasi → hapus ritase;
  :Redirect back;

elseif (Cek DT) then
  :Klik "Cek DT";
  :Sistem hitung DT\nper sopir per tujuan;
  :Tampilkan ringkasan DT;

elseif (Detail) then
  :Klik "Detail";
  :Sistem generate\npivot sopir x tanggal;
  :Tampilkan di modal/iframe;

  if (Download PDF?) then (ya)
    :Generate PDF via DomPDF;
    :Download detail.pdf;
  endif

endif
stop

@enduml

@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title Evolusi Fitur Validasi Bukti dari Kebutuhan Mitra

partition "Iterasi 1 - Sudah Jalan" {
  start
  :Sopir foto bukti pengiriman;
  :Admin login, buka daftar bukti;
  :Admin setujui atau tolak manual;
  stop
  note right
    **Masalah dari Mitra:**
    - Setiap bukti harus di-setujui satu-satu
    - Ritase harus diinput ulang terpisah
  end note
}

partition "Iterasi 2 - Ditingkatkan" {
  start
  :Admin aktifkan aturan otomatis;
  :Setujui bukti -> otomatis\nritase langsung terbuat;
  stop
  note right
    **Perbaikan dari keluhan Mitra:**
    - Sekali klik, ritase langsung jadi
    - Ga perlu input ulang
  end note
}

partition "Final - Lengkap" {
  start
  :Tambah ritase manual dari bukti;\n(bisa ditambah catatan mitra);
  stop
  note right
    **Tambahan dari Mitra:**
    - Fleksibel: otomatis atau manual
    - Ada catatan mitra
  end note
}

@enduml

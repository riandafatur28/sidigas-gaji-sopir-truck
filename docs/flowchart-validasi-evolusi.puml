@startuml
!theme plain
skinparam backgroundColor #ffffff
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam partitionBackgroundColor #f0f5ff
skinparam partitionBorderColor #2b6cb0
skinparam partitionFontSize 13
skinparam partitionFontStyle bold

title Evolusi Fitur Validasi Bukti dari Kebutuhan Mitra

partition "Iterasi 1 - Input Manual" {
  start
  :Sopir buka form validasi;
  :Ketik manual nama sopir;
  :Ketik manual nama tujuan;
  :Ambil foto;
  :Kirim;
  stop
  note right
    **Keluhan Mitra:**
    - Sopir sering salah ketik nama
    - Nama ga konsisten (Adib vs Adieb)
    - Minta: "Biar tinggal pilih aja"
  end note
}

partition "Iterasi 2 - Pilih Dropdown" {
  start
  :Sopir buka form validasi;
  :Pilih nama sopir dari dropdown;
  :Pilih nama tujuan dari dropdown;
  :(kecuali sopir/tujuan baru,\nbaru ngetik manual);
  :Ambil foto;
  :Kirim;
  stop
  note right
    **Yang didapat Mitra:**
    - Tinggal pilih, ga perlu ngetik
    - Nama pasti konsisten
    - Kalaupun ada sopir baru,\nmasih bisa input manual
  end note
}

partition "Final - Lengkap" {
  start
  :Admin bisa toggle aturan otomatis;\n(setujui -> ritase langsung jadi);
  :Bisa tambah catatan mitra;
  stop
}

@enduml
